<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    tools:context=".exercitiuSem4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Titlul Pagininii -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Configurează Geanta"
            android:textColor="#2D3142"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- CARTONAȘ 1: Detalii Principale -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Brandul Genții"
                    android:textColor="#9094A6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ID respectat: brand -->
                <EditText
                    android:id="@+id/brand"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="ex. Hermes, Chanel"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#2D3142"
                    android:textSize="16sp" />

                <!-- ID respectat: este_noua -->
                <Switch
                    android:id="@+id/este_noua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Produsul este nou"
                    android:textColor="#2D3142"
                    android:textSize="16sp"
                    android:theme="@style/Theme.AppCompat.Light"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />

                <!-- ID respectat: garantie -->
                <CheckBox
                    android:id="@+id/garantie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Include garanție"
                    android:textColor="#2D3142"
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARTONAȘ 2: Specificații -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Selectează Mărimea"
                    android:textColor="#9094A6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ID respectat: marimeMare -->
                    <RadioButton
                        android:id="@+id/marimeMare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mare"
                        android:textColor="#2D3142"
                        android:textSize="16sp" />

                    <!-- ID respectat: marimeMica -->
                    <RadioButton
                        android:id="@+id/marimeMica"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mică"
                        android:textColor="#2D3142"
                        android:textSize="16sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="Material Principal"
                    android:textColor="#9094A6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ID respectat: material -->
                <Spinner
                    android:id="@+id/material"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:entries="@array/material" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="Calitate Evaluată (Rating)"
                    android:textColor="#9094A6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- ID respectat: rating -->
                <RatingBar
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:numStars="5"
                    android:progressTint="#FFB300"
                    android:stepSize="0.5" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BUTONUL DE SALVARE -->
        <!-- Metodă respectată: creeazaGeanta -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="#4F46E5"
            android:onClick="creeazaGeanta"
            android:text="SALVEAZĂ GEANTA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>